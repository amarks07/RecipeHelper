{
  "expo": {
    "name": "Nibble",
    "slug": "nibble",
    "owner": "amarks07",
    "version": "0.1.0",
    "scheme": "nibble",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nibble.app"
    },
    "android": {
      "package": "com.nibble.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/FingerPaint-Regular.ttf"]
        }
      ],
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nibble to use the camera to capture recipe photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nibble to access your photos to import recipes.",
          "cameraPermission": "Allow Nibble to use the camera to take recipe photos.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "c1ceb9e8-164c-4c9f-a29f-281536556e81"
      }
    }
  }
}
